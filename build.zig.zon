.{
    .name = .zmx,
    .version = "0.8.1",
    .fingerprint = 0x28aad87005052b4e, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .ghostty = .{
            // A Ghostty checkout beside this one, prepared by whoever builds
            // (Resesh: eng/build-agent.ps1, which pins the commit and applies
            // a patch to the VT formatter). A path and not a URL, because Zig
            // cannot unpack the Ghostty package on Windows without the right
            // to create symlinks.
            .path = "../ghostty",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
